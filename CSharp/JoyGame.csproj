<Project Sdk="Microsoft.NET.Sdk">
  <!-- project_proxy3d 的 C# 游戏逻辑程序集。
       最终由 C++ 瘦宿主（joy cs 模块 / MonoVM）加载 JoyGame.dll 并调用
       JoyGame.GameApplication.Initialize / Update / Shutdown。
       当前阶段：骨架 + 定点数 + GameState 雏形，尚未接入宿主的帧驱动。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 自包含 publish 需要 restore 阶段就把 RID 写进 project.assets.json，
         否则 NETSDK1047。声明所有目标平台。 -->
    <!-- RID 由 publish 时的 -r 指定，不预声明，避免 restore 为全部 RID 拉包。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>JoyGame</AssemblyName>
    <RootNamespace>ProxyGame</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <JoyCSharpDir Condition="'$(JoyCSharpDir)' == ''">$(MSBuildProjectDirectory)/../third_party/joy/modules/cs</JoyCSharpDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- joy 的强类型绑定（含 JmathFp* 定点数 + R3dExt 手写 r3d 适配） -->
    <ProjectReference Include="$(JoyCSharpDir)/Joy.Bindings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 目录布局：Runtime=宿主/骨架，Game=玩法，Test=验证脚本 -->
    <Compile Include="Runtime\**\*.cs" />
    <!-- 3D 表现层：C# 自建窗口/r3d、战斗场景渲染（迁移自 C++ scenes/passes） -->
    <Compile Include="Runtime3D\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="Test\**\*.cs" />
  </ItemGroup>
</Project>
