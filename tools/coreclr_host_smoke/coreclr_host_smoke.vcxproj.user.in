<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerDebuggerType>NativeWithManagedCore</LocalDebuggerDebuggerType>
    <LocalDebuggerWorkingDirectory>@CMAKE_BINARY_DIR@/Debug/ManagedSmoke</LocalDebuggerWorkingDirectory>
    <LocalDebuggerEnvironment>DOTNET_EnableDiagnostics=1&#xA;COMPlus_EnableDiagnostics=1</LocalDebuggerEnvironment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerDebuggerType>NativeWithManagedCore</LocalDebuggerDebuggerType>
    <LocalDebuggerWorkingDirectory>@CMAKE_BINARY_DIR@/Release/ManagedSmoke</LocalDebuggerWorkingDirectory>
    <LocalDebuggerEnvironment>DOTNET_EnableDiagnostics=1&#xA;COMPlus_EnableDiagnostics=1</LocalDebuggerEnvironment>
  </PropertyGroup>
</Project>
